{
  "name": "cpin-explorer-web",
  "private": true,
  "type": "module",
  "description": "Front-end toolchain: vendors COBE, map data and fonts into the prototypes (no CDN at runtime).",
  "scripts": {
    "vendor": "node build-vendor.mjs",
    "test": "node --test test/*.test.mjs",
    "borders": "node build-borders.mjs",
    "search-index": "PYTHONPATH=../src ../.venv/bin/python -m cpin.search_records && node build-search.mjs",
    "docx": "node build-docx.mjs",
    "docx-samples": "node build-docx.mjs --samples"
  },
  "dependencies": {
    "cobe": "2.0.1",
    "d3-geo": "3.1.1",
    "flag-icons": "^7.5.0",
    "geist": "1.7.2",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "docx": "^9.8.1",
    "esbuild": "0.28.2",
    "mapshaper": "^0.7.72",
    "pagefind": "1.5.2"
  }
}
