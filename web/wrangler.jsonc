// Public static assets stay at the CDN; /api/* is handled by the optional account Worker.
// Deploy with `npm run deploy` from web/. Public, but every response carries X-Robots-Tag: noindex.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cpin-explorer",
  "main": "accounts/worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "AUTH_ORIGIN": "https://cpin-explorer.co.uk" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": true, "head_sampling_rate": 0.1 } }
}
