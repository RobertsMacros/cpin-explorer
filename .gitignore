.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Mirrored PDFs are large and reproducible from data/pdfs/manifest.json; they go to R2, not git.
data/pdfs/files/

# Local views and browser-event scratch for downloaded National Archives PDFs.
# Source URLs, hashes and indices remain in data/pdfs/national-archives/.
data/pdfs/national-archives/By country/
data/pdfs/national-archives/files
data/pdfs/national-archives/browser-downloads.jsonl
data/pdfs/national-archives/tool-log-offset.txt

# Atomic-write temp files
.tmp-*

# Mirrored images, like PDFs, go to R2 rather than git.
data/images/files/

# What `cpin recover` has already read from the Internet Archive (index answers, archived listing pages).
# A cache: everything in it can be asked for again. The catalogue built from it is data/wayback-catalogue.json.
data/wayback-cache/

# Derived by ./cpin export (large: every edition of every comparable report).
prototypes/data/

# Rewritten by every `cpin verify` (timestamped); derived, so not committed.
data/verify-report.json
# Rewritten by every `cpin pdftext --check`; its findings are written up in docs/reviews/.
data/pdftext-check.json
# Rewritten by every `cpin compare`: the summary table. The records it is made from are in data/pdfs/compare/.
data/pdf-web-compare.json

# Full-text search index (Pagefind), rebuilt by `cd web && npm run search-index`.
prototypes/search/pagefind/

# Word lock files
~$*

# Deployable site, assembled by `cd web && npm run site` (see web/build-site.mjs).
site/
.wrangler/

# Private third-party source evidence, attempts and extracted text. Never deployed.
data/source-evidence/

# Third-party review snapshots and unvetted discovery queue; never deployed.
data/review-evidence/

# Private bounded discovery work; the assessed report is retained in docs.
data/research/mechanical-source-checks/
